        "operation": "addLabels",
        "messageId": "={{ $json.id }}",
        "labelIds": "={{ [$('Trouver les libellés IA').first().json.ids[$json.categorie]] }}"
      },
      "id": "316d4750-009a-5319-95c4-a22d5c9ba340",
      "name": "Ranger dans son libellé",
