      "id": "678c5bf6-c7eb-5d2d-9f4d-de797a29c1bd",
      "name": "Tout regrouper",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1560,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "// Écrit le résumé de 8 h : ce qu'il reste à traiter, les factures avec leur montant, ce qui a été rangé.\nconst mails = $input.first().json.mails ?? [];\nconst par = (c) => mails.filter((m) => m.categorie === c);\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[ch]));\nconst aTraiter = [...par('urgent'), ...par('client')];\nconst ligne = (m) => `<li><b>${esc(m.nom || m.de)}</b> : ${esc(m.sujet)}<br><small>${esc(m.resume)}${m.categorie === 'client' ? ' · <b>brouillon prêt</b>' : ''}</small></li>`;\nconst factures = par('facture');\nconst html = `<h2>📬 ${aTraiter.length} mail${aTraiter.length > 1 ? 's' : ''} à traiter ce matin</h2>\n<ul>${aTraiter.map(ligne).join('') || '<li>Rien d\\'urgent 🎉</li>'}</ul>\n<h3>🧾 Factures (${factures.length})</h3>\n<ul>${factures.map((m) => `<li>${esc(m.fournisseur || m.nom || m.de)} : <b>${esc(m.montant || 'montant à vérifier')}</b></li>`).join('') || '<li>Aucune</li>'}</ul>\n<p>Rangé : ${par('newsletter').length} newsletter(s) et ${par('poubelle').length} mail(s) inutile(s), sortis de ta boîte de réception (rien n'est supprimé).</p>\n<p><small>Les brouillons sont dans Gmail : rien n'est envoyé sans toi.</small></p>`;\nreturn [{ json: { sujet: `${aTraiter.length} mail${aTraiter.length > 1 ? 's' : ''} à traiter, le reste est rangé`, html } }];"
      },
      "id": "3c29f69d-6031-5e4a-a176-b3d6b0ec9c27",
      "name": "Écrire le résumé",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        600
      ]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $now.set({ hour: 8, minute: 0, second: 0, millisecond: 0 }).toISO() }}"
      },
      "id": "154493fb-20f5-54be-a688-7b324f54d96b",
      "name": "Attendre 8 h",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
