        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Retrouve l'identifiant Gmail de chaque libellé IA-… (à créer une fois dans Gmail).\nconst NOMS = {\"urgent\": \"IA-Urgent\", \"client\": \"IA-Client\", \"facture\": \"IA-Facture\", \"newsletter\": \"IA-Newsletter\", \"poubelle\": \"IA-Poubelle\"};\nconst parNom = Object.fromEntries($input.all().map((l) => [l.json.name, l.json.id]));\nconst manquants = Object.values(NOMS).filter((n) => !parNom[n]);\nif (manquants.length) throw new Error(`Crée d'abord ces libellés dans Gmail : ${manquants.join(', ')}`);\nconst ids = Object.fromEntries(Object.entries(NOMS).map(([cat, nom]) => [cat, parNom[nom]]));\nreturn [{ json: { ids } }];"
      },
      "id": "287ce18b-11cc-5a56-8e13-d8d09398793c",
      "name": "Trouver les libellés IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 50,
        "simple": false,
        "filters": {
          "q": "in:inbox is:unread newer_than:1d -label:ia-urgent -label:ia-client -label:ia-facture -label:ia-newsletter -label:ia-poubelle"
        },
        "options": {}
      },
      "id": "c4b2fb88-a4d2-5c89-a18b-90da36b3d27d",
      "name": "Mails non lus des dernières 24 h",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tu tries les mails de {{ $('Réglages').first().json.monNom }}. Classe ce mail dans UNE catégorie :\n- urgent : demande une action rapide (problème, échéance proche, personne qui attend une réponse aujourd'hui)\n- client : un client ou un prospect qui écrit (question, devis, commande, suivi)\n- facture : une facture, un reçu ou une demande de paiement\n- newsletter : lettre d'information, promotion, notification automatique\n- poubelle : publicité non sollicitée, spam, rien d'utile\n\nRends aussi :\n- resume : une phrase de 15 mots au plus, en français\n- montant et fournisseur : seulement pour une facture (montant avec la devise, ex. « 49,90 € »), sinon null\n- brouillon : seulement pour un client, une réponse prête à relire, dans ce style : {{ $('Réglages').first().json.monStyle }}. Ne promets rien que le mail ne permet pas de savoir (prix, délai) : mets [à compléter] à la place. Sinon null.\n\nDe : {{ $json.from?.text ?? '' }}\nObjet : {{ $json.subject ?? '' }}\nTexte :\n{{ ($json.text ?? $json.snippet ?? '').slice(0, 4000) }}",
        "hasOutputParser": true
      },
      "id": "de0a5822-018e-508c-a809-401ebd743385",
      "name": "Classer avec Claude",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "6c53824e-ee02-5d0d-8ad9-8aabde87bd84",
      "name": "Modèle Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1060,
        520
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"categorie\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"urgent\",\n        \"client\",\n        \"facture\",\n        \"newsletter\",\n        \"poubelle\"\n      ]\n    },\n    \"resume\": {\n      \"type\": \"string\"\n    },\n    \"montant\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"fournisseur\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"brouillon\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"categorie\",\n    \"resume\",\n    \"montant\",\n    \"fournisseur\",\n    \"brouillon\"\n  ]\n}"
      },
      "id": "e6b2f033-1c4f-5cd5-8898-690e05367f90",
      "name": "Format de la réponse",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1240,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// Associe chaque mail à son classement (même ordre que la liste des mails).\nconst mails = $('Mails non lus des dernières 24 h').all();\nreturn $input.all().map((item, i) => {\n  const m = mails[i].json;\n  const c = item.json.output ?? {};\n  return { json: {\n    id: m.id,\n    threadId: m.threadId,\n    de: m.from?.value?.[0]?.address ?? '',\n    nom: m.from?.value?.[0]?.name ?? '',\n    sujet: m.subject ?? '(sans objet)',\n    categorie: ['urgent', 'client', 'facture', 'newsletter', 'poubelle'].includes(c.categorie) ? c.categorie : 'urgent',\n    resume: c.resume ?? '',\n    montant: c.montant ?? null,\n    fournisseur: c.fournisseur ?? null,\n    brouillon: c.brouillon ?? null,\n  } };\n});"
      },
      "id": "f41d40aa-e78e-52b1-85db-ae2e9d1caeea",
      "name": "Mail + classement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
